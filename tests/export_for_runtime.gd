extends SceneTree

const BrewEngineScript = preload("res://scripts/mod_engine.gd")

## Export is performed by the *existing DeepBrew native engine* in another
## process, not generated by the Python harness.

func _initialize() -> void:
	var args := OS.get_cmdline_user_args()
	if args.size() != 1:
		print("EXPORT_REFUSED expected one destination filename")
		quit(9)
		return
	var engine := BrewEngineScript.new()
	var imported := engine.import_target("res://examples/door_trigger.brew.json")
	if not imported.get("ok", false):
		print("EXPORT_REFUSED import failed")
		quit(9)
		return
	var proposed := engine.preview_change("open", 1500)
	if not proposed.get("is_change", false):
		print("EXPORT_REFUSED preview was not a real diff")
		quit(9)
		return
	var applied := engine.apply_preview()
	if not applied.get("ok", false) or not engine.test_simulation().get("ok", false):
		print("EXPORT_REFUSED working-copy mutation failed")
		quit(9)
		return
	var exported := engine.export_mod(args[0])
	if not exported.get("ok", false):
		print("EXPORT_REFUSED verified export failed")
		quit(9)
		return
	print("DEEPBREW_NATIVE_EXPORT " + str(exported["hash"]))
	var rolled := engine.rollback_to_import()
	if not rolled.get("ok", false) or rolled.get("restored_hash", "") != engine.source_hash:
		print("EXPORT_REFUSED rollback verification failed")
		quit(9)
		return
	print("DEEPBREW_NATIVE_ROLLBACK " + str(rolled["restored_hash"]))
	quit(0)
